# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Secret Configuration
JWT_SECRET=super_secret_jwt_key_exam_management_system_2026_production
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL Production)
# Set DB_DIALECT to 'mysql' (default) or 'sqlite' for quick local evaluation
DB_DIALECT=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=online_exam_db
DB_STORAGE=./database.sqlite

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis Cache & Queue Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
